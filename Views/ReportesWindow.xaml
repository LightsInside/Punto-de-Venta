<Window x:Class="ZarelyPOS.Views.ReportesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarely POS — Reportes y Estadisticas"
        Height="780" Width="1240"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">

    <Window.Resources>
        <Style x:Key="KpiValor" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
        </Style>
        <Style x:Key="KpiEtiqueta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ═══ HEADER ═══ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushYellow}" BorderThickness="0,0,0,3" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Images/logo.png" Height="34" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" | " Foreground="{StaticResource BrushMuted}" FontSize="18"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="Reportes y Estadisticas" Style="{StaticResource TextHeading2}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtUsuarioHeader" Style="{StaticResource TextMuted}"/>
                    </Border>
                    <Button Content="Regresar" Style="{StaticResource ButtonOutline}" Padding="12,6" Click="BtnRegresar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TOOLBAR (rango de fechas) ═══ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Desde:" Style="{StaticResource LabelForm}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DpDesde" Width="140" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Hasta:" Style="{StaticResource LabelForm}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DpHasta" Width="140" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Calcular" Style="{StaticResource ButtonOutline}"
                        Padding="16,8" VerticalAlignment="Center" Margin="0,0,14,0" Click="BtnCalcular_Click"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Hoy" Style="{StaticResource ButtonOutline}" Padding="10,6" Margin="0,0,6,0" Click="BtnHoy_Click"/>
                    <Button Content="7 dias" Style="{StaticResource ButtonOutline}" Padding="10,6" Margin="0,0,6,0" Click="Btn7_Click"/>
                    <Button Content="Mes" Style="{StaticResource ButtonOutline}" Padding="10,6" Margin="0,0,6,0" Click="BtnMes_Click"/>
                    <Button Content="Todo" Style="{StaticResource ButtonOutline}" Padding="10,6" Click="BtnTodo_Click"/>
                </StackPanel>

                <Button Grid.Column="5" Content="🖨️  Exportar a PDF" Style="{StaticResource ButtonPrimary}"
                        Padding="16,8" VerticalAlignment="Center" Click="BtnExportarPdf_Click"/>
            </Grid>
        </Border>

        <!-- ═══ CONTENIDO ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>

                <TextBlock x:Name="TxtRango" Text="" Style="{StaticResource TextMuted}" Margin="0,0,0,14"/>

                <!-- KPIs -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel><TextBlock x:Name="TxtKpiTotal" Text="$0.00" Style="{StaticResource KpiValor}"/>
                            <TextBlock Text="Total vendido" Style="{StaticResource KpiEtiqueta}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel><TextBlock x:Name="TxtKpiVentas" Text="0" Style="{StaticResource KpiValor}"/>
                            <TextBlock Text="Ventas" Style="{StaticResource KpiEtiqueta}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel><TextBlock x:Name="TxtKpiTicket" Text="$0.00" Style="{StaticResource KpiValor}"/>
                            <TextBlock Text="Ticket promedio" Style="{StaticResource KpiEtiqueta}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel><TextBlock x:Name="TxtKpiUnidades" Text="0" Style="{StaticResource KpiValor}"/>
                            <TextBlock Text="Pares vendidos" Style="{StaticResource KpiEtiqueta}"/></StackPanel>
                    </Border>
                    <Border Grid.Column="8" Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel><TextBlock x:Name="TxtKpiDescuentos" Text="$0.00" Style="{StaticResource KpiValor}"
                                               Foreground="{StaticResource BrushDestructive}"/>
                            <TextBlock Text="Descuentos" Style="{StaticResource KpiEtiqueta}"/></StackPanel>
                    </Border>
                </Grid>

                <!-- Metodo de pago + grafica -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Metodo de pago -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Metodo de pago" Style="{StaticResource TextHeading2}" FontSize="15" Margin="0,0,0,12"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtRepEfectivoLbl" Text="Efectivo" Style="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtRepEfectivo" Grid.Column="1" Text="$0.00" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Height="8" Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColEfectivo" Width="0*"/>
                                    <ColumnDefinition x:Name="ColEfectivoResto" Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource BrushPrimary}"/>
                                <Border Grid.Column="1" CornerRadius="4" Background="{StaticResource BrushBorder}"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtRepTarjetaLbl" Text="Tarjeta" Style="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtRepTarjeta" Grid.Column="1" Text="$0.00" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid Height="8" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColTarjeta" Width="0*"/>
                                    <ColumnDefinition x:Name="ColTarjetaResto" Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource BrushAccent}"/>
                                <Border Grid.Column="1" CornerRadius="4" Background="{StaticResource BrushBorder}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Grafica ventas por dia -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Ventas por dia" Style="{StaticResource TextHeading2}" FontSize="15" Margin="0,0,0,12"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="IcVentasDia" Height="210">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="46" Height="200" Margin="3,0">
                                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalCorto}" FontSize="9"
                                                               HorizontalAlignment="Center" Margin="0,0,0,2"
                                                               Foreground="{StaticResource BrushMuted}"/>
                                                    <Border Width="26" Height="{Binding AlturaPx}"
                                                            Background="{StaticResource BrushPrimary}" CornerRadius="4,4,0,0"/>
                                                    <TextBlock Text="{Binding Etiqueta}" FontSize="9"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0"
                                                               Foreground="{StaticResource BrushMuted}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="TxtSinGrafica" Text="Sin datos en el rango." Style="{StaticResource TextMuted}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Top productos + Stock bajo -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Productos mas vendidos" Style="{StaticResource TextHeading2}" FontSize="15" Margin="0,0,0,12"/>
                            <DataGrid x:Name="GridTop" Style="{StaticResource DataGridBase}"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                                      CellStyle="{StaticResource DataGridCell}" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Pares" Binding="{Binding Cantidad}" Width="70"/>
                                    <DataGridTextColumn Header="Ingreso" Binding="{Binding Importe, StringFormat=C2}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtSinTop" Text="Sin ventas en el rango." Style="{StaticResource TextMuted}"
                                       Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Stock bajo (reabastecer)" Style="{StaticResource TextHeading2}" FontSize="15" Margin="0,0,0,12"/>
                            <DataGrid x:Name="GridStock" Style="{StaticResource DataGridBase}"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                                      CellStyle="{StaticResource DataGridCell}" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Stock" Binding="{Binding StockTotal}" Width="70"/>
                                    <DataGridTextColumn Header="Reorden" Binding="{Binding PuntoReorden}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtSinStock" Text="Todo el inventario esta por encima del punto de reorden. 👌"
                                       Style="{StaticResource TextMuted}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
