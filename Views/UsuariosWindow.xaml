<Window x:Class="ZarelyPOS.Views.UsuariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarely POS — Gestion de Usuarios"
        Height="640" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">

    <DockPanel>

        <!-- ═══ HEADER ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushYellow}"
                BorderThickness="0,0,0,3"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Images/logo.png" Height="34" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" | " Foreground="{StaticResource BrushMuted}"
                               FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="Gestion de Usuarios" Style="{StaticResource TextHeading2}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtUsuarioHeader" Style="{StaticResource TextMuted}"/>
                    </Border>
                    <Button Content="Regresar" Style="{StaticResource ButtonOutline}"
                            Padding="12,6" Click="BtnRegresar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TOOLBAR ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Usuarios" Style="{StaticResource TextHeading2}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="12"
                            Padding="8,2" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtConteo" Text="0" FontSize="12"
                                   Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="6" Margin="16,0"
                        Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#x1F50D;" Grid.Column="0" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Foreground="{StaticResource BrushMuted}"/>
                        <TextBox x:Name="TxtBuscar"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 Padding="8,8"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 TextChanged="TxtBuscar_TextChanged"/>
                    </Grid>
                </Border>

                <Button x:Name="BtnNuevo" Grid.Column="2"
                        Content="+ Nuevo Usuario"
                        Style="{StaticResource ButtonPrimary}"
                        Padding="14,8"
                        Click="BtnNuevo_Click"/>
            </Grid>
        </Border>

        <!-- ═══ PANEL LATERAL: FORMULARIO ═══ -->
        <Border x:Name="PanelFormulario"
                DockPanel.Dock="Right"
                Width="380"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1,0,0,0"
                Padding="24"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock x:Name="TxtTituloForm"
                               Text="Nuevo Usuario"
                               Style="{StaticResource TextHeading2}"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Primer Nombre *" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FPrimerNombre" Style="{StaticResource InputBase}" Margin="0,0,0,12"/>

                    <TextBlock Text="Primer Apellido *" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FPrimerApellido" Style="{StaticResource InputBase}" Margin="0,0,0,12"/>

                    <TextBlock Text="Nombre de Usuario *" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FNombreUsuario" Style="{StaticResource InputBase}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,12"
                               Text="Sera el identificador para iniciar sesion. Debe ser unico."/>

                    <!-- Contrasena (solo visible al crear) -->
                    <StackPanel x:Name="PanelPassword">
                        <TextBlock Text="Contrasena *" Style="{StaticResource LabelForm}"/>
                        <PasswordBox x:Name="FPassword" Style="{StaticResource PasswordBoxBase}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,12"
                                   Text="Minimo 6 caracteres."/>
                    </StackPanel>

                    <!-- Al editar: boton para abrir el dialogo de restablecer contrasena -->
                    <StackPanel x:Name="PanelRestablecer" Visibility="Collapsed">
                        <TextBlock Text="Contrasena" Style="{StaticResource LabelForm}"/>
                        <Button x:Name="BtnRestablecer"
                                Content="Restablecer contrasena..."
                                Style="{StaticResource ButtonOutline}"
                                HorizontalAlignment="Stretch"
                                Padding="10,8"
                                Margin="0,0,0,12"
                                Click="BtnRestablecer_Click"/>
                    </StackPanel>

                    <TextBlock Text="Rol *" Style="{StaticResource LabelForm}"/>
                    <ComboBox x:Name="FRol"
                              FontFamily="Segoe UI" FontSize="13"
                              Padding="8,6" Margin="0,0,0,16">
                        <ComboBoxItem Content="Usuario Regular" IsSelected="True"/>
                        <ComboBoxItem Content="Administrador"/>
                    </ComboBox>

                    <CheckBox x:Name="FActivo"
                              Content="Usuario activo (puede iniciar sesion)"
                              IsChecked="True"
                              FontFamily="Segoe UI" FontSize="13"
                              Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource ButtonOutline}"
                                Height="38"
                                Click="BtnCancelar_Click"/>
                        <Button Grid.Column="2" x:Name="BtnGuardar"
                                Content="Guardar"
                                Style="{StaticResource ButtonPrimary}"
                                Height="38"
                                Click="BtnGuardar_Click"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ TABLA ═══ -->
        <DataGrid x:Name="GridUsuarios"
                  Style="{StaticResource DataGridBase}"
                  Margin="20,16"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                  CellStyle="{StaticResource DataGridCell}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre"   Binding="{Binding PrimerNombre}"   Width="140"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding PrimerApellido}" Width="140"/>
                <DataGridTextColumn Header="Usuario"  Binding="{Binding NombreUsuario}"  Width="140"/>
                <DataGridTextColumn Header="Rol"      Binding="{Binding Rol}"            Width="140"/>
                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding Activo, Converter={StaticResource ActivoToTextoConverter}}"
                                    Width="90"/>

                <DataGridTemplateColumn Header="Acciones" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource ButtonIcon}"
                                        ToolTip="Editar"
                                        Click="BtnEditar_Click"
                                        Tag="{Binding}">
                                    <TextBlock Text="&#x270E;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ButtonIcon}"
                                        ToolTip="Restablecer contrasena"
                                        Click="BtnRestablecerFila_Click"
                                        Tag="{Binding}"
                                        Margin="4,0,0,0">
                                    <TextBlock Text="&#x1F511;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ButtonIcon}"
                                        ToolTip="Eliminar usuario"
                                        Click="BtnEliminar_Click"
                                        Tag="{Binding}"
                                        Margin="4,0,0,0">
                                    <TextBlock Text="&#x1F5D1;" FontSize="14"
                                               Foreground="{StaticResource BrushDestructive}"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
