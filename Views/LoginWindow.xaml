<Window x:Class="ZarelyPOS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarely POS — Inicio de Sesion"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}">
    <Grid>
        <Border Style="{StaticResource Card}"
                Width="360"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="32">
            <StackPanel>
                <Image Source="/Resources/Images/logo.png"
                       Width="250"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Franja amarilla de marca -->
                <Border Height="4" Width="250" CornerRadius="2"
                        Background="{StaticResource BrushYellow}"
                        HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Sistema de Punto de Venta"
                           Style="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <Border x:Name="PanelError"
                        Background="#FEE2E2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtError"
                               Foreground="#DC2626"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Usuario" Style="{StaticResource LabelForm}"/>
                <TextBox x:Name="TxtUsuario"
                         Style="{StaticResource InputBase}"
                         Margin="0,0,0,14"
                         KeyDown="Input_KeyDown"/>

                <TextBlock Style="{StaticResource LabelForm}"><Run Text="Contrase"/><Run Language="es-mx" Text="ñ"/><Run Text="a"/></TextBlock>
                <PasswordBox x:Name="TxtPassword"
                             Style="{StaticResource PasswordBoxBase}"
                             Margin="0,0,0,24"
                             KeyDown="Input_KeyDown"/>

                <Button x:Name="BtnLogin"
                        Content="Iniciar Sesion"
                        Style="{StaticResource ButtonPrimary}"
                        Height="42"
                        Click="BtnLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
