<Window x:Class="ZarelyPOS.Views.ProductosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ZarelyPOS.Helpers"
        Title="Zarely POS — Productos"
        Height="720" Width="1280"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">

    <Window.Resources>
        <helpers:RutaImagenConverter x:Key="RutaImagenConverter"/>
    </Window.Resources>

    <DockPanel>

        <!-- ═══ HEADER ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushYellow}"
                BorderThickness="0,0,0,3"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Images/logo.png" Height="34" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" | " Foreground="{StaticResource BrushMuted}"
                               FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="Productos" Style="{StaticResource TextHeading2}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtUsuarioHeader" Style="{StaticResource TextMuted}"/>
                    </Border>
                    <Button Content="Regresar" Style="{StaticResource ButtonOutline}"
                            Padding="12,6" Click="BtnRegresar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ BANNER SOLO LECTURA (visible si no es admin) ═══ -->
        <Border x:Name="BannerSoloLectura"
                DockPanel.Dock="Top"
                Background="#FEF3C7"
                BorderBrush="#D97706"
                BorderThickness="0,0,0,1"
                Padding="20,10"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Modo solo lectura" FontWeight="Bold" Foreground="#92400E"/>
                    <TextBlock Text="Puedes consultar el catalogo. Para crear o modificar productos, contacta a un administrador."
                               Foreground="#92400E" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ TOOLBAR ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titulo + conteo -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Productos" Style="{StaticResource TextHeading2}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="12"
                            Padding="8,2" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtConteo" Text="0" FontSize="12"
                                   Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Filtros y busqueda -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                    <!-- Buscar -->
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6"
                            Background="White" Width="260" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" Grid.Column="0" VerticalAlignment="Center"
                                       Margin="10,0,0,0" Foreground="{StaticResource BrushMuted}"/>
                            <TextBox x:Name="TxtBuscar" Grid.Column="1" BorderThickness="0"
                                     FontSize="13" Padding="8,8" Background="Transparent"
                                     VerticalAlignment="Center" TextChanged="Filtros_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Filtro categoria -->
                    <TextBlock Text="Categoria:" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbFiltroCategoria" Width="140" Margin="0,0,8,0"
                              FontSize="12" SelectionChanged="Filtros_Changed"/>

                    <!-- Filtro proveedor -->
                    <TextBlock Text="Proveedor:" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbFiltroProveedor" Width="170"
                              FontSize="12" SelectionChanged="Filtros_Changed"/>
                </StackPanel>

                <!-- Nuevo producto -->
                <Button x:Name="BtnNuevo" Grid.Column="2"
                        Content="+ Nuevo Producto"
                        Style="{StaticResource ButtonPrimary}"
                        Padding="14,8"
                        Click="BtnNuevo_Click"/>
            </Grid>
        </Border>

        <!-- ═══ TABLA ═══ -->
        <DataGrid x:Name="GridProductos"
                  Style="{StaticResource DataGridBase}"
                  Margin="20,16"
                  RowHeight="64"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                  CellStyle="{StaticResource DataGridCell}">
            <DataGrid.Columns>

                <!-- Imagen -->
                <DataGridTemplateColumn Header="" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="48" Height="48"
                                    Background="#F1F5F9"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Image Source="{Binding RutaImagen, Converter={StaticResource RutaImagenConverter}}"
                                       Stretch="UniformToFill"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Nombre y marca -->
                <DataGridTemplateColumn Header="Producto" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushPrimary}" FontSize="13"/>
                                <TextBlock Text="{Binding Marca}" Style="{StaticResource TextMuted}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Categoria"
                                    Binding="{Binding Categoria.Nombre, FallbackValue=(sin categoria)}"
                                    Width="110"/>
                <DataGridTextColumn Header="Proveedor"
                                    Binding="{Binding Proveedor.Nombre, FallbackValue=(sin proveedor)}"
                                    Width="150"/>
                <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="110"/>
                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="80"/>

                <DataGridTextColumn Header="Precio"
                                    Binding="{Binding Precio, StringFormat='${0:N2}'}"
                                    Width="90"/>

                <!-- Resumen de tallas: "25:8   26:12   27:15..." -->
                <DataGridTemplateColumn Header="Inventario por talla" Width="*" MinWidth="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Tallas}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9"
                                                CornerRadius="4"
                                                Padding="6,3"
                                                Margin="0,0,4,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="T" FontSize="10"
                                                           Foreground="{StaticResource BrushMuted}"/>
                                                <TextBlock Text="{Binding Talla}" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushPrimary}"/>
                                                <TextBlock Text=": " FontSize="11"
                                                           Foreground="{StaticResource BrushMuted}"/>
                                                <TextBlock Text="{Binding StockActual}" FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BrushPrimary}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Total"
                                    Binding="{Binding StockTotal}"
                                    Width="60"/>

                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80"/>

                <!-- Acciones (se ocultan para usuarios regulares) -->
                <DataGridTemplateColumn x:Name="ColAcciones" Header="Acciones" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource ButtonIcon}" ToolTip="Editar"
                                        Click="BtnEditar_Click" Tag="{Binding}">
                                    <TextBlock Text="&#x270E;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ButtonIcon}" ToolTip="Eliminar"
                                        Click="BtnEliminar_Click" Tag="{Binding}" Margin="4,0,0,0">
                                    <TextBlock Text="&#x1F5D1;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
