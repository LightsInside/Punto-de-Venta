<Window x:Class="ZarelyPOS.Views.RecepcionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarely POS — Recepcion de Mercancia"
        Height="820" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">

    <DockPanel>

        <!-- ═══ HEADER ═══ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushYellow}" BorderThickness="0,0,0,3" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Images/logo.png" Height="34" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" | " Foreground="{StaticResource BrushMuted}" FontSize="18"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="Recepcion de Mercancia" Style="{StaticResource TextHeading2}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtUsuarioHeader" Style="{StaticResource TextMuted}"/>
                    </Border>
                    <Button Content="Regresar" Style="{StaticResource ButtonOutline}" Padding="12,6" Click="BtnRegresar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ FOOTER (acciones) ═══ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtMensaje" Grid.Column="0" VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="{StaticResource BrushDestructive}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource ButtonOutline}" Padding="18,9"
                            Margin="0,0,10,0" Click="BtnRegresar_Click"/>
                    <Button x:Name="BtnRegistrar" Content="Registrar recepcion" Style="{StaticResource ButtonPrimary}"
                            Padding="18,9" Click="BtnRegistrar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ CONTENIDO ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <TextBlock Text="Registrar entrada de inventario" Style="{StaticResource TextHeading1}" Margin="0,0,0,4"/>
                <TextBlock Text="Recibe mercancia de un proveedor: suma stock a un producto existente o da de alta uno nuevo."
                           Style="{StaticResource TextMuted}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                <!-- Proveedor (obligatorio para toda la recepcion) -->
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Proveedor *" Style="{StaticResource LabelForm}"/>
                        <ComboBox x:Name="CmbProveedor" Height="38" FontSize="13"
                                  DisplayMemberPath="Nombre"/>
                        <TextBlock Text="El proveedor del que llega la mercancia. Obligatorio."
                                   Style="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Modo: existente o nuevo -->
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Que vas a recibir?" Style="{StaticResource LabelForm}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <RadioButton x:Name="RbExistente" Content="Producto existente (sumar stock)"
                                         GroupName="ModoRecepcion" IsChecked="True" Margin="0,0,24,0"
                                         VerticalContentAlignment="Center" Checked="Modo_Changed"/>
                            <RadioButton x:Name="RbNuevo" Content="Producto nuevo (dar de alta)"
                                         GroupName="ModoRecepcion" VerticalContentAlignment="Center"
                                         Checked="Modo_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ PANEL: PRODUCTO EXISTENTE ═══ -->
                <Border x:Name="PanelExistente" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Buscar producto" Style="{StaticResource LabelForm}"/>
                        <TextBox x:Name="TxtBuscar" Style="{StaticResource InputBase}" Height="38"
                                 TextChanged="TxtBuscar_TextChanged"/>
                        <ListBox x:Name="LstSugerencias" Visibility="Collapsed" MaxHeight="200" Margin="0,4,0,0"
                                 FontSize="13" DisplayMemberPath="Display"
                                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="LstSugerencias_SelectionChanged"/>

                        <TextBlock Text="Producto seleccionado" Style="{StaticResource LabelForm}" Margin="0,12,0,0"/>
                        <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Padding="12,10">
                            <TextBlock x:Name="TxtProductoSel" Text="Ninguno" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushPrimary}"/>
                        </Border>

                        <!-- Tallas del producto: recibir cantidad por talla -->
                        <TextBlock Text="Cantidad recibida por talla" Style="{StaticResource LabelForm}" Margin="0,14,0,4"/>
                        <ItemsControl x:Name="ListaTallasExist">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Talla}" FontWeight="SemiBold"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StockTexto}"
                                                   Style="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Style="{StaticResource InputBase}" Height="34"
                                                 Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="Cantidad_Changed"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtSinTallas" Text="Selecciona un producto para ver sus tallas."
                                   Style="{StaticResource TextMuted}" FontSize="12"/>

                        <!-- Agregar una talla que el producto aun no tiene -->
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>
                        <TextBlock Text="Agregar una talla no listada" Style="{StaticResource LabelForm}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Talla:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="TxtTallaNueva" Style="{StaticResource InputBase}" Width="90" Height="34"/>
                            <TextBlock Text="Cantidad:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                            <TextBox x:Name="TxtCantNueva" Style="{StaticResource InputBase}" Width="90" Height="34"/>
                            <Button Content="Agregar talla" Style="{StaticResource ButtonOutline}" Padding="12,6"
                                    Margin="12,0,0,0" Click="BtnAgregarTallaExist_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ PANEL: PRODUCTO NUEVO ═══ -->
                <Border x:Name="PanelNuevo" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Datos del calzado" Style="{StaticResource TextHeading2}" FontSize="15" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Marca *" Style="{StaticResource LabelForm}"/>
                                <TextBox x:Name="FMarca" Style="{StaticResource InputBase}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Nombre / Modelo *" Style="{StaticResource LabelForm}"/>
                                <TextBox x:Name="FNombre" Style="{StaticResource InputBase}" Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                                <TextBlock Text="Modelo / Codigo" Style="{StaticResource LabelForm}"/>
                                <TextBox x:Name="FModelo" Style="{StaticResource InputBase}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                <TextBlock Text="Color" Style="{StaticResource LabelForm}"/>
                                <TextBox x:Name="FColor" Style="{StaticResource InputBase}" Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
                                <TextBlock Text="Precio de venta *" Style="{StaticResource LabelForm}"/>
                                <TextBox x:Name="FPrecio" Style="{StaticResource InputBase}" Height="36"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
                                <TextBlock Text="Costo unitario" Style="{StaticResource LabelForm}"/>
                                <TextBox x:Name="FCosto" Style="{StaticResource InputBase}" Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,10,0,0">
                                <TextBlock Text="Categoria" Style="{StaticResource LabelForm}"/>
                                <ComboBox x:Name="FCategoria" Height="36" FontSize="13" DisplayMemberPath="Nombre"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,10,0,0">
                                <TextBlock Text="Punto de reorden" Style="{StaticResource LabelForm}"/>
                                <TextBox x:Name="FReorden" Style="{StaticResource InputBase}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Tallas iniciales y cantidad recibida" Style="{StaticResource LabelForm}" Margin="0,16,0,4"/>
                        <ItemsControl x:Name="ListaTallasNuevo">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Talla:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource InputBase}" Height="34"
                                                 Text="{Binding Talla, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="Cantidad:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                        <TextBox Grid.Column="3" Style="{StaticResource InputBase}" Height="34"
                                                 Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="4" Style="{StaticResource ButtonIcon}" Content="✕"
                                                Tag="{Binding}" Click="BtnQuitarTallaNuevo_Click" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Agregar talla" Style="{StaticResource ButtonOutline}" Padding="12,6"
                                HorizontalAlignment="Left" Margin="0,4,0,0" Click="BtnAgregarTallaNuevo_Click"/>
                    </StackPanel>
                </Border>

                <!-- Total recibido -->
                <Border Background="{StaticResource BrushAccent}" CornerRadius="8" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Total de pares a recibir" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalRecibir" Grid.Column="1" Text="0"
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
