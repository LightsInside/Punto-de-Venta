<Window x:Class="ZarelyPOS.Views.HistorialVentasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarely POS — Historial de Ventas"
        Height="680" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">

    <Window.Resources>
        <!-- Alinea a la derecha el texto de las columnas numericas (importes/cantidades) -->
        <Style x:Key="CellRight" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <!-- Grid raiz: capa 1 = UI principal, capa 2 = overlay de detalle -->
    <Grid>

        <DockPanel>

            <!-- ═══ HEADER ═══ -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushYellow}"
                    BorderThickness="0,0,0,3"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Resources/Images/logo.png" Height="34" Stretch="Uniform"
                               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text=" | " Foreground="{StaticResource BrushMuted}"
                                   FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBlock Text="Historial de Ventas" Style="{StaticResource TextHeading2}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                        <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtUsuarioHeader" Style="{StaticResource TextMuted}"/>
                        </Border>
                        <Button Content="Regresar" Style="{StaticResource ButtonOutline}"
                                Padding="12,6" Click="BtnRegresar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ TOOLBAR ═══ -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Titulo + conteo -->
                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Ventas registradas" Style="{StaticResource TextHeading2}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource BrushAccent}" CornerRadius="12"
                                Padding="8,2" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtConteo" Text="0" FontSize="12"
                                       Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{StaticResource BrushAccent}" CornerRadius="12"
                                Padding="8,2" Margin="6,0,0,0">
                            <TextBlock x:Name="TxtTotalMostrado" Text="$0.00" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Filtro por dia -->
                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Dia:" Style="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker x:Name="DpFecha" Width="140" VerticalAlignment="Center"
                                    SelectedDateChanged="Fecha_Changed"/>
                        <Button Content="Todas" Style="{StaticResource ButtonOutline}"
                                Padding="10,6" Margin="8,0,0,0" Click="BtnTodas_Click"/>
                    </StackPanel>

                    <!-- Buscador (por folio o cliente) -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6"
                                Background="White" Width="360">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" Grid.Column="0" VerticalAlignment="Center"
                                           Margin="10,0,0,0" Foreground="{StaticResource BrushMuted}"/>
                                <TextBox x:Name="TxtBuscar" Grid.Column="1" BorderThickness="0"
                                         FontSize="13" Padding="8,8" Background="Transparent"
                                         VerticalAlignment="Center" TextChanged="Filtros_Changed"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ TABLA DE VENTAS ═══ -->
            <DataGrid x:Name="GridVentas"
                      Style="{StaticResource DataGridBase}"
                      Margin="20,16"
                      IsReadOnly="True"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                      CellStyle="{StaticResource DataGridCell}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Folio"
                                        Binding="{Binding Id, StringFormat='V-{0:D4}'}" Width="90"/>
                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding FechaTexto}" Width="150"/>
                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding ClienteNombre}" Width="2*"/>
                    <DataGridTextColumn Header="Articulos"
                                        Binding="{Binding TotalArticulos}" Width="90"
                                        ElementStyle="{StaticResource CellRight}"/>
                    <DataGridTextColumn Header="Total"
                                        Binding="{Binding Total, StringFormat=C2}" Width="120"
                                        ElementStyle="{StaticResource CellRight}"/>
                    <DataGridTextColumn Header="Metodo"
                                        Binding="{Binding MetodoPago}" Width="110"/>

                    <!-- Estado como pill de color -->
                    <DataGridTemplateColumn Header="Estado" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,3"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Estado}" Value="Cancelado">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Estado}" FontSize="12" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#166534"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Estado}" Value="Cancelado">
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Vendedor"
                                        Binding="{Binding UsuarioNombre}" Width="1.5*"/>

                    <!-- Acciones: ver detalles / eliminar -->
                    <DataGridTemplateColumn Header="Acciones" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource ButtonIcon}" ToolTip="Ver detalles"
                                            Click="BtnDetalles_Click" Tag="{Binding}">
                                        <TextBlock Text="&#x1F441;" FontSize="14"/>
                                    </Button>
                                    <Button Style="{StaticResource ButtonIcon}"
                                            ToolTip="Eliminar venta"
                                            Click="BtnEliminar_Click" Tag="{Binding}"
                                            Margin="4,0,0,0">
                                        <TextBlock Text="&#x1F5D1;" FontSize="14"
                                                   Foreground="{StaticResource BrushDestructive}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ═══ OVERLAY: DETALLE DE LA VENTA (ticket) ═══                -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="OverlayDetalle"
                Background="#88000000"
                Visibility="Collapsed">
            <Border Style="{StaticResource Card}"
                    Width="660" MaxHeight="620" Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <DockPanel>

                    <!-- Titulo -->
                    <TextBlock x:Name="TxtDetalleTitulo" DockPanel.Dock="Top"
                               Text="Detalle de venta"
                               Style="{StaticResource TextHeading2}" Margin="0,0,0,16"/>

                    <!-- Cabecera con datos de la venta -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource BrushAccent}"
                            CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Folio:"
                                           Style="{StaticResource TextMuted}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DTxtFolio"
                                           FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Fecha:"
                                           Style="{StaticResource TextMuted}" Margin="12,2,8,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="DTxtFecha"
                                           FontWeight="SemiBold" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cliente:"
                                           Style="{StaticResource TextMuted}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DTxtCliente"
                                           FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Vendedor:"
                                           Style="{StaticResource TextMuted}" Margin="12,2,8,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="DTxtVendedor"
                                           FontWeight="SemiBold" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Pago:"
                                           Style="{StaticResource TextMuted}" Margin="0,2,8,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DTxtMetodo"
                                           FontWeight="SemiBold" Margin="0,2"/>
                            </Grid>
                            <TextBlock x:Name="DTxtEfectivo" Margin="0,6,0,0"
                                       Style="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Total + boton cerrar (abajo) -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total:" FontFamily="Segoe UI" FontSize="16"
                                       FontWeight="Medium" Foreground="{StaticResource BrushMuted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="DTxtTotal" Text="$0.00"
                                       FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🖨️  Generar PDF"
                                    Style="{StaticResource ButtonOutline}" Padding="16,8"
                                    Click="BtnTicketPdf_Click"/>
                            <Button Content="Cerrar"
                                    Style="{StaticResource ButtonPrimary}" Padding="20,8"
                                    Margin="8,0,0,0"
                                    Click="BtnCerrarDetalle_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Renglones de la venta -->
                    <DataGrid x:Name="GridDetalle"
                              Style="{StaticResource DataGridBase}"
                              IsReadOnly="True"
                              MinHeight="120"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                              CellStyle="{StaticResource DataGridCell}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto"
                                                Binding="{Binding ProductoNombre}" Width="2*"/>
                            <DataGridTextColumn Header="Talla"
                                                Binding="{Binding Talla}" Width="70"/>
                            <DataGridTextColumn Header="Cant."
                                                Binding="{Binding Cantidad}" Width="70"
                                                ElementStyle="{StaticResource CellRight}"/>
                            <DataGridTextColumn Header="P. Unitario"
                                                Binding="{Binding PrecioUnitario, StringFormat=C2}" Width="110"
                                                ElementStyle="{StaticResource CellRight}"/>
                            <DataGridTextColumn Header="Subtotal"
                                                Binding="{Binding Subtotal, StringFormat=C2}" Width="120"
                                                ElementStyle="{StaticResource CellRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </Border>
        </Border>

    </Grid>
</Window>
