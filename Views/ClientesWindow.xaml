<Window x:Class="ZarelyPOS.Views.ClientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarely POS — Clientes"
        Height="680" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">

    <DockPanel>

        <!-- ═══ HEADER ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushYellow}"
                BorderThickness="0,0,0,3"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Images/logo.png" Height="34" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" | " Foreground="{StaticResource BrushMuted}"
                               FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="Clientes" Style="{StaticResource TextHeading2}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtUsuarioHeader" Style="{StaticResource TextMuted}"/>
                    </Border>
                    <Button Content="Regresar" Style="{StaticResource ButtonOutline}"
                            Padding="12,6" Click="BtnRegresar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ BANNER USUARIO REGULAR ═══ -->
        <!-- Para usuarios regulares: pueden agregar pero no editar/desactivar.
             El banner les informa de su nivel de acceso. -->
        <Border x:Name="BannerSoloAgregar"
                DockPanel.Dock="Top"
                Background="#DBEAFE"
                BorderBrush="#1A365D"
                BorderThickness="0,0,0,1"
                Padding="20,10"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ℹ" FontSize="16" VerticalAlignment="Center" Foreground="#1A365D"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Acceso parcial" FontWeight="Bold" Foreground="#1A365D"/>
                    <TextBlock Text="Puedes consultar la lista y registrar nuevos clientes. Para editar o desactivar clientes, contacta a un administrador."
                               Foreground="#1A365D" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ TOOLBAR ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titulo + conteo -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Clientes" Style="{StaticResource TextHeading2}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="12"
                            Padding="8,2" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtConteo" Text="0" FontSize="12"
                                   Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Buscador y filtro de estado -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6"
                            Background="White" Width="320" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" Grid.Column="0" VerticalAlignment="Center"
                                       Margin="10,0,0,0" Foreground="{StaticResource BrushMuted}"/>
                            <TextBox x:Name="TxtBuscar" Grid.Column="1" BorderThickness="0"
                                     FontSize="13" Padding="8,8" Background="Transparent"
                                     VerticalAlignment="Center" TextChanged="Filtros_Changed"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Estado:" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbFiltroEstado" Width="130"
                              FontSize="12" SelectionChanged="Filtros_Changed">
                        <ComboBoxItem Content="Todos"     IsSelected="True"/>
                        <ComboBoxItem Content="Activos"/>
                        <ComboBoxItem Content="Inactivos"/>
                    </ComboBox>
                </StackPanel>

                <!-- Nuevo cliente -->
                <Button x:Name="BtnNuevo" Grid.Column="2"
                        Content="+ Nuevo Cliente"
                        Style="{StaticResource ButtonPrimary}"
                        Padding="14,8"
                        Click="BtnNuevo_Click"/>
            </Grid>
        </Border>

        <!-- ═══ PANEL LATERAL DE FORMULARIO ═══ -->
        <Border x:Name="PanelFormulario"
                DockPanel.Dock="Right"
                Width="420"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1,0,0,0"
                Padding="24"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock x:Name="TxtTituloForm"
                               Text="Nuevo Cliente"
                               Style="{StaticResource TextHeading2}"
                               Margin="0,0,0,16"/>

                    <!-- Nombre y Apellido en una fila -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nombre *" Style="{StaticResource LabelForm}"/>
                            <TextBox x:Name="FNombre" Style="{StaticResource InputBase}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Apellido *" Style="{StaticResource LabelForm}"/>
                            <TextBox x:Name="FApellido" Style="{StaticResource InputBase}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Telefono -->
                    <TextBlock Text="Telefono" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FTelefono" Style="{StaticResource InputBase}" Margin="0,0,0,12"/>

                    <!-- Correo -->
                    <TextBlock Text="Correo electronico" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FCorreo" Style="{StaticResource InputBase}" Margin="0,0,0,12"/>

                    <!-- RFC -->
                    <TextBlock Text="RFC (opcional, para facturacion)" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FRFC" Style="{StaticResource InputBase}" Margin="0,0,0,4"
                             MaxLength="13" CharacterCasing="Upper"/>
                    <TextBlock Style="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,12"
                               Text="Debe ser unico en el sistema. Maximo 13 caracteres."/>

                    <!-- Direccion -->
                    <TextBlock Text="Direccion" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FDireccion" Style="{StaticResource InputBase}"
                             Height="60"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12"/>

                    <!-- Fecha de nacimiento -->
                    <TextBlock Text="Fecha de nacimiento" Style="{StaticResource LabelForm}"/>
                    <DatePicker x:Name="FFechaNacimiento"
                                FontSize="13" Height="34"
                                Margin="0,0,0,12"/>

                    <!-- Notas -->
                    <TextBlock Text="Notas" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FNotas" Style="{StaticResource InputBase}"
                             Height="60"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,16"/>

                    <!-- Activo (solo visible para admin al editar) -->
                    <CheckBox x:Name="FActivo"
                              Content="Cliente activo"
                              IsChecked="True"
                              FontFamily="Segoe UI" FontSize="13"
                              Margin="0,0,0,20"/>

                    <!-- Botones -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource ButtonOutline}"
                                Height="38"
                                Click="BtnCancelar_Click"/>
                        <Button Grid.Column="2" x:Name="BtnGuardar"
                                Content="Guardar"
                                Style="{StaticResource ButtonPrimary}"
                                Height="38"
                                Click="BtnGuardar_Click"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ TABLA ═══ -->
        <DataGrid x:Name="GridClientes"
                  Style="{StaticResource DataGridBase}"
                  Margin="20,16"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                  CellStyle="{StaticResource DataGridCell}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre"   Binding="{Binding Nombre}"   Width="110"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="110"/>
                <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="110"/>
                <DataGridTextColumn Header="Correo"   Binding="{Binding Correo}"   Width="200"/>
                <DataGridTextColumn Header="RFC"      Binding="{Binding RFC}"      Width="120"/>
                <DataGridTextColumn Header="Direccion" Binding="{Binding Direccion}" Width="*"/>
                <DataGridTextColumn Header="Estado"   Binding="{Binding EstadoTexto}" Width="80"/>

                <DataGridTemplateColumn x:Name="ColAcciones" Header="Acciones" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource ButtonIcon}" ToolTip="Editar"
                                        Click="BtnEditar_Click" Tag="{Binding}">
                                    <TextBlock Text="&#x270E;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ButtonIcon}"
                                        ToolTip="Activar / Desactivar"
                                        Click="BtnAlternarEstado_Click" Tag="{Binding}"
                                        Margin="4,0,0,0">
                                    <TextBlock Text="&#x21BB;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ButtonIcon}"
                                        ToolTip="Eliminar cliente"
                                        Click="BtnEliminar_Click" Tag="{Binding}"
                                        Margin="4,0,0,0">
                                    <TextBlock Text="&#x1F5D1;" FontSize="14"
                                               Foreground="{StaticResource BrushDestructive}"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
