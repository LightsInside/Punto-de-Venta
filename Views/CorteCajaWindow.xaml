<Window x:Class="ZarelyPOS.Views.CorteCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarely POS — Corte de Caja"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">

    <Window.Resources>
        <Style x:Key="FilaEtiqueta" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FilaValor" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ═══ HEADER ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushYellow}"
                BorderThickness="0,0,0,3"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Images/logo.png" Height="34" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" | " Foreground="{StaticResource BrushMuted}"
                               FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="Corte de Caja" Style="{StaticResource TextHeading2}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtUsuarioHeader" Style="{StaticResource TextMuted}"/>
                    </Border>
                    <Button Content="Regresar" Style="{StaticResource ButtonOutline}"
                            Padding="12,6" Click="BtnRegresar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TOOLBAR (filtros) ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Dia -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="Dia:" Style="{StaticResource LabelForm}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DpFecha" Width="150" VerticalAlignment="Center"
                                SelectedDateChanged="Filtros_Changed"/>
                </StackPanel>

                <!-- Fondo de caja -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="Fondo de caja:" Style="{StaticResource LabelForm}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="FFondo" Width="100" Text="0"
                             Style="{StaticResource InputBase}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Calcular -->
                <Button Grid.Column="2" Content="Calcular"
                        Style="{StaticResource ButtonOutline}" Padding="16,8"
                        VerticalAlignment="Center" Click="BtnCalcular_Click"/>

                <!-- Exportar PDF -->
                <Button Grid.Column="4" x:Name="BtnExportar" Content="🖨️  Exportar a PDF"
                        Style="{StaticResource ButtonPrimary}" Padding="16,8"
                        VerticalAlignment="Center" Click="BtnExportarPdf_Click"/>
            </Grid>
        </Border>

        <!-- ═══ RESUMEN ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Padding="32"
                    Width="560" Margin="0,28"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel>

                    <TextBlock x:Name="TxtResumenTitulo" Text="Resumen del dia"
                               Style="{StaticResource TextHeading2}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtResumenFecha" Style="{StaticResource TextMuted}" Margin="0,0,0,20"/>

                    <!-- Ventas -->
                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Numero de ventas" Style="{StaticResource FilaEtiqueta}"/>
                        <TextBlock x:Name="TxtNumVentas" Grid.Column="1" Text="0" Style="{StaticResource FilaValor}"/>
                    </Grid>
                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Subtotal (bruto)" Style="{StaticResource FilaEtiqueta}"/>
                        <TextBlock x:Name="TxtSubtotal" Grid.Column="1" Text="$0.00" Style="{StaticResource FilaValor}"/>
                    </Grid>
                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Descuentos otorgados" Style="{StaticResource FilaEtiqueta}"/>
                        <TextBlock x:Name="TxtDescuentos" Grid.Column="1" Text="$0.00"
                                   Style="{StaticResource FilaValor}" Foreground="{StaticResource BrushDestructive}"/>
                    </Grid>

                    <!-- Total vendido (destacado) -->
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="8" Padding="16,12" Margin="0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL VENDIDO" VerticalAlignment="Center"
                                       FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource BrushPrimary}"/>
                            <TextBlock x:Name="TxtTotalVendido" Grid.Column="1" Text="$0.00"
                                       FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource BrushPrimary}"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Ticket promedio" Style="{StaticResource FilaEtiqueta}"/>
                        <TextBlock x:Name="TxtTicketProm" Grid.Column="1" Text="$0.00" Style="{StaticResource FilaValor}"/>
                    </Grid>

                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,14"/>

                    <!-- Por metodo de pago -->
                    <TextBlock Text="Desglose por metodo de pago" Style="{StaticResource TextHeading2}"
                               FontSize="15" Margin="0,0,0,8"/>
                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtEfectivoLbl" Text="Efectivo" Style="{StaticResource FilaEtiqueta}"/>
                        <TextBlock x:Name="TxtEfectivo" Grid.Column="1" Text="$0.00" Style="{StaticResource FilaValor}"/>
                    </Grid>
                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtTarjetaLbl" Text="Tarjeta" Style="{StaticResource FilaEtiqueta}"/>
                        <TextBlock x:Name="TxtTarjeta" Grid.Column="1" Text="$0.00" Style="{StaticResource FilaValor}"/>
                    </Grid>

                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,14"/>

                    <!-- Caja -->
                    <TextBlock Text="Caja" Style="{StaticResource TextHeading2}" FontSize="15" Margin="0,0,0,8"/>
                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Fondo inicial" Style="{StaticResource FilaEtiqueta}"/>
                        <TextBlock x:Name="TxtFondo" Grid.Column="1" Text="$0.00" Style="{StaticResource FilaValor}"/>
                    </Grid>
                    <Border Background="#DCFCE7" CornerRadius="8" Padding="16,12" Margin="0,8,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="EFECTIVO ESPERADO EN CAJA" VerticalAlignment="Center"
                                       FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#166534"/>
                            <TextBlock x:Name="TxtEfectivoCaja" Grid.Column="1" Text="$0.00"
                                       FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#166534"/>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,14"/>

                    <!-- Zapatos vendidos en el dia -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Zapatos vendidos" Style="{StaticResource TextHeading2}" FontSize="15"/>
                        <TextBlock x:Name="TxtUnidades" Grid.Column="1" Text="0 pares"
                                   Style="{StaticResource TextMuted}" VerticalAlignment="Bottom"/>
                    </Grid>
                    <DataGrid x:Name="GridProductos"
                              Style="{StaticResource DataGridBase}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                              CellStyle="{StaticResource DataGridCell}"
                              MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Talla" Binding="{Binding Talla}" Width="60"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="55"/>
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=C2}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="TxtSinProductos" Text="Sin ventas registradas en este dia."
                               Style="{StaticResource TextMuted}" Margin="0,8,0,0" Visibility="Collapsed"/>

                </StackPanel>
            </Border>
        </ScrollViewer>

    </DockPanel>
</Window>
