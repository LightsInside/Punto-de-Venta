<Window x:Class="ZarelyPOS.Views.CambiarPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar Contrasena"
        Height="500" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}">
    <Grid>
        <Border Style="{StaticResource Card}"
                Width="360"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="28">
            <StackPanel>
                <TextBlock x:Name="TxtTitulo"
                           Style="{StaticResource TextHeading2}"
                           Margin="0,0,0,6"><Run Text="Cambiar Contrase"/><Run Language="es-mx" Text="ñ"/><Run Text="a"/></TextBlock>
                <TextBlock x:Name="TxtSubtitulo"
                           Style="{StaticResource TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <Border x:Name="PanelError"
                        Background="#FEE2E2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtError"
                               Foreground="#DC2626"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Contrasena actual (solo cuando NO es admin restableciendo) -->
                <StackPanel x:Name="PanelActual">
                    <TextBlock Style="{StaticResource LabelForm}"><Run Text="Contrase"/><Run Language="es-mx" Text="ñ"/><Run Text="a actual *"/></TextBlock>
                    <PasswordBox x:Name="FActual"
                                 Style="{StaticResource PasswordBoxBase}"
                                 Margin="0,0,0,14"/>
                </StackPanel>

                <TextBlock Style="{StaticResource LabelForm}"><Run Text="Nueva contrase"/><Run Language="es-mx" Text="ñ"/><Run Text="a *"/></TextBlock>
                <PasswordBox x:Name="FNueva"
                             Style="{StaticResource PasswordBoxBase}"
                             Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,14"
                           Text="Minimo 6 caracteres."/>

                <TextBlock Style="{StaticResource LabelForm}"><Run Text="Confirmar nueva contrase"/><Run Language="es-mx" Text="ñ"/><Run Text="a *"/></TextBlock>
                <PasswordBox x:Name="FConfirmar"
                             Style="{StaticResource PasswordBoxBase}"
                             Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar"
                            Style="{StaticResource ButtonOutline}"
                            Height="38"
                            Click="BtnCancelar_Click"/>
                    <Button Grid.Column="2" Content="Guardar"
                            Style="{StaticResource ButtonPrimary}"
                            Height="38"
                            Click="BtnGuardar_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
