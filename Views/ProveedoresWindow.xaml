<Window x:Class="ZarelyPOS.Views.ProveedoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zarely POS — Proveedores"
        Height="680" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBackground}">

    <DockPanel>

        <!-- ═══ HEADER ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushYellow}"
                BorderThickness="0,0,0,3"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/Images/logo.png" Height="34" Stretch="Uniform"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text=" | " Foreground="{StaticResource BrushMuted}"
                               FontSize="18" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="Proveedores" Style="{StaticResource TextHeading2}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtUsuarioHeader" Style="{StaticResource TextMuted}"/>
                    </Border>
                    <Button Content="Regresar" Style="{StaticResource ButtonOutline}"
                            Padding="12,6" Click="BtnRegresar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ TOOLBAR ═══ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titulo + conteo -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Proveedores" Style="{StaticResource TextHeading2}" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="12"
                            Padding="8,2" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtConteo" Text="0" FontSize="12"
                                   Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Buscador -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6"
                            Background="White" Width="340">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" Grid.Column="0" VerticalAlignment="Center"
                                       Margin="10,0,0,0" Foreground="{StaticResource BrushMuted}"/>
                            <TextBox x:Name="TxtBuscar" Grid.Column="1" BorderThickness="0"
                                     FontSize="13" Padding="8,8" Background="Transparent"
                                     VerticalAlignment="Center" TextChanged="Filtros_Changed"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Nuevo proveedor -->
                <Button x:Name="BtnNuevo" Grid.Column="2"
                        Content="+ Nuevo Proveedor"
                        Style="{StaticResource ButtonPrimary}"
                        Padding="14,8"
                        Click="BtnNuevo_Click"/>
            </Grid>
        </Border>

        <!-- ═══ PANEL LATERAL DE FORMULARIO ═══ -->
        <Border x:Name="PanelFormulario"
                DockPanel.Dock="Right"
                Width="420"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1,0,0,0"
                Padding="24"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock x:Name="TxtTituloForm"
                               Text="Nuevo Proveedor"
                               Style="{StaticResource TextHeading2}"
                               Margin="0,0,0,16"/>

                    <!-- Nombre -->
                    <TextBlock Text="Nombre / Razon social *" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FNombre" Style="{StaticResource InputBase}" Margin="0,0,0,12"/>

                    <!-- Telefono -->
                    <TextBlock Text="Telefono" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FTelefono" Style="{StaticResource InputBase}" Margin="0,0,0,12"/>

                    <!-- Correo -->
                    <TextBlock Text="Correo electronico" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FCorreo" Style="{StaticResource InputBase}" Margin="0,0,0,12"/>

                    <!-- Direccion -->
                    <TextBlock Text="Direccion" Style="{StaticResource LabelForm}"/>
                    <TextBox x:Name="FDireccion" Style="{StaticResource InputBase}"
                             Height="70"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,20"/>

                    <!-- Botones -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancelar"
                                Style="{StaticResource ButtonOutline}"
                                Height="38"
                                Click="BtnCancelar_Click"/>
                        <Button Grid.Column="2" x:Name="BtnGuardar"
                                Content="Guardar"
                                Style="{StaticResource ButtonPrimary}"
                                Height="38"
                                Click="BtnGuardar_Click"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ TABLA ═══ -->
        <DataGrid x:Name="GridProveedores"
                  Style="{StaticResource DataGridBase}"
                  Margin="20,16"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                  CellStyle="{StaticResource DataGridCell}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre / Razon social" Binding="{Binding Nombre}"   Width="2*"/>
                <DataGridTextColumn Header="Telefono"              Binding="{Binding Telefono}" Width="130"/>
                <DataGridTextColumn Header="Correo"                Binding="{Binding Correo}"   Width="220"/>
                <DataGridTextColumn Header="Direccion"             Binding="{Binding Direccion}" Width="3*"/>

                <DataGridTemplateColumn Header="Acciones" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource ButtonIcon}" ToolTip="Editar"
                                        Click="BtnEditar_Click" Tag="{Binding}">
                                    <TextBlock Text="&#x270E;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ButtonIcon}"
                                        ToolTip="Eliminar"
                                        Click="BtnEliminar_Click" Tag="{Binding}"
                                        Margin="4,0,0,0">
                                    <TextBlock Text="&#x1F5D1;" FontSize="14"
                                               Foreground="{StaticResource BrushDestructive}"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
