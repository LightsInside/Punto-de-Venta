<Application x:Class="ZarelyPOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ZarelyPOS.Helpers"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters globales -->
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <helpers:StringToVisibilityConverter x:Key="StringToVisibility"/>
            <helpers:ActivoToTextoConverter x:Key="ActivoToTextoConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
